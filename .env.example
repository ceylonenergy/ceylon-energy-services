# =====================================================================
#  Ceylon Energy Services — settings
#
#  Copy this file to ".env" in the same folder (the project root) and
#  fill in the values. .env is ignored by git: never commit real secrets.
#
#  On a host with an environment-variables screen (Render, Railway,
#  cPanel "Setup Node.js App"), enter the same names and values there
#  instead of uploading a .env file.
# =====================================================================

# ---------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------

# MongoDB Atlas -> your cluster -> Connect -> Drivers -> copy the string,
# then put your database user's password in place of <db_password>.
# If the password contains any of  @ : / ? # [ ] %  percent-encode it
# (p@ss -> p%40ss), otherwise the login fails with a confusing error.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster (created automatically).
MONGODB_DB_NAME=ceylonenergy

# DNS servers used to look up a mongodb+srv:// address (optional).
# Leave empty: the server uses this computer's DNS and, if that refuses
# the lookup ("querySrv ECONNREFUSED" — common on Windows and with some
# home/office routers), automatically retries through 1.1.1.1 and 8.8.8.8.
# Set it to always use specific servers, e.g. DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=

# Signs admin login sessions. Long and random; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everybody out.
JWT_SECRET=change_me_to_a_long_random_string

# ---------------------------------------------------------------------
# Images — Cloudinary (recommended; optional)
#
# The 51 existing project photos already live in Cloudinary. With these
# three set, new uploads go there too (CDN + automatic resizing/WebP).
# Leave them empty to store images in MongoDB GridFS instead.
# Cloudinary Console -> Settings -> API Keys.
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder that uploads go under in your Cloudinary media library.
CLOUDINARY_BASE_FOLDER=ceylon-energy
# auto (default) = Cloudinary when the three values above are set, else GridFS.
STORAGE_DRIVER=auto

# ---------------------------------------------------------------------
# Contact-form email — any SMTP server (optional)
#
# Every enquiry is always saved in Admin -> Messages. With SMTP set it is
# also emailed to CONTACT_TO. Examples:
#   cPanel mail:  SMTP_HOST=mail.ceylonenergyservices.com  SMTP_PORT=465
#   Gmail:        SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  (use an App Password)
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender address; most servers require it to be the SMTP_USER mailbox.
MAIL_FROM=
# Who receives enquiries (comma-separated).
CONTACT_TO=info@ceylonenergyservices.com,sales@ceylonenergyservices.com
# smtp | console (print emails in the terminal — handy locally) | disabled
# Defaults to smtp when SMTP_HOST is set, otherwise disabled.
# MAIL_TRANSPORT=console

# ---------------------------------------------------------------------
# First admin account from the browser (optional)
#
# Set this, open /admin/setup, enter the same value there to create the
# first admin, then remove it. Without it, create the first admin with:
#   npm run create-admin
# ---------------------------------------------------------------------
ADMIN_SETUP_TOKEN=

# ---------------------------------------------------------------------
# Server (usually leave as they are)
# ---------------------------------------------------------------------

# Local port. Most hosts (Render, cPanel/Passenger) set PORT themselves —
# do not set it there. Not 5000: macOS AirPlay Receiver occupies it.
PORT=5050

# production on a live server (enables secure cookies and HTTPS rules).
NODE_ENV=development

# How long an admin stays logged in, in hours.
SESSION_HOURS=12

# Only when the React site is hosted on a different domain from this API:
# the site's address(es), comma-separated, no spaces, no trailing slash.
ALLOWED_ORIGINS=

# Proxies in front of Node (1 on Render, cPanel/Passenger, Nginx). Wrong
# values make every visitor look like one IP to the rate limits.
# Defaults to 1 in production.
# TRUST_PROXY=1

# lax (default) — or "none" if the admin panel runs on a different site
# than the API (then COOKIE_SECURE must be true and HTTPS is required).
# COOKIE_SAMESITE=lax
